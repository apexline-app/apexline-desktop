{
  "name": "apexline-desktop",
  "productName": "apexline-desktop",
  "version": "0.0.1",
  "description": "Apexline desktop app — Electron + React + TypeScript.",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:format": "prettier --check '**/*.{js,jsx,ts,tsx,css,md,json}' --config .prettierrc",
    "lint:types": "tsc --noEmit --skipLibCheck --pretty true",
    "gen:routes": "tsr generate",
    "prelint:types": "tsr generate",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,css,md,json}' --log-level silent --config .prettierrc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "is-ci || husky"
  },
  "keywords": [
    "apexline",
    "electron",
    "desktop",
    "iracing"
  ],
  "author": {
    "name": "Damian Kądziela",
    "email": "damiankadziela4@gmail.com"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexline-app/apexline-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/apexline-app/apexline-desktop/issues"
  },
  "homepage": "https://github.com/apexline-app/apexline-desktop#readme",
  "devDependencies": {
    "@commitlint/cli": "20.5.2",
    "@commitlint/config-conventional": "20.5.0",
    "@electron-forge/cli": "7.11.1",
    "@electron-forge/maker-deb": "7.11.1",
    "@electron-forge/maker-rpm": "7.11.1",
    "@electron-forge/maker-squirrel": "7.11.1",
    "@electron-forge/maker-zip": "7.11.1",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.1",
    "@electron-forge/plugin-fuses": "7.11.1",
    "@electron-forge/plugin-vite": "7.11.1",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.2.4",
    "@tanstack/router-cli": "1.166.36",
    "@tanstack/router-plugin": "1.167.27",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/is-ci": "3.0.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.5",
    "electron": "41.3.0",
    "eslint": "10.2.1",
    "globals": "17.5.0",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "prettier": "3.8.3",
    "tailwindcss": "4.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.0",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "@apexline-app/apr": "0.1.2",
    "@tanstack/react-router": "1.168.24",
    "electron-squirrel-startup": "1.0.1",
    "electron-window-state": "5.0.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "4.3.6"
  }
}
